<?php
$DB_IPS = "{% for host in groups['database_nodes'] %}{{ hostvars[host].ansible_host }}:27017{% if not loop.last %},{% endif %}{% endfor %}";
$DB_NAME = "{{ mongodb_db }}";
$MONGO_USER = "{{ mongodb_app_user | default('') }}";
$MONGO_PASS = "{{ mongodb_app_pass | default('') }}";
$MONGO_TLS = {% if mongodb_app_tls | default(false) | bool %}true{% else %}false{% endif %};
$MONGO_TLS_CA_FILE = "{{ mongodb_tls_ca_file | default('/etc/ssl/mongodb/mongoCA.crt') }}";
$REPLICA_SET = "{{ replica_set_name | default('rs0') }}";
$LOGIN_ENFORCED = {% if web_login_enforced | default(false) | bool %}true{% else %}false{% endif %};
$LOGIN_USER = "{{ web_login_user | default('app_writer') }}";
$LOGIN_PASS = "{{ web_login_pass | default('WriterPass123!') }}";
$LOGIN_COOKIE = 'cis_demo_login';
$LOGIN_COOKIE_SIG = 'cis_demo_login_sig';
$LOGIN_SECRET = hash('sha256', __FILE__ . '|' . $LOGIN_USER);

$baseUri = $MONGO_USER !== ''
    ? sprintf("mongodb://%s:%s@%s", rawurlencode($MONGO_USER), rawurlencode($MONGO_PASS), $DB_IPS)
    : "mongodb://$DB_IPS";

$uriQuery = [
    'replicaSet' => $REPLICA_SET,
    'serverSelectionTimeoutMS' => 5000,
    'connectTimeoutMS' => 5000,
    'socketTimeoutMS' => 5000,
];

if ($MONGO_USER !== '') {
    $uriQuery['authSource'] = 'admin';
}

if ($MONGO_TLS) {
    $uriQuery['tls'] = 'true';
    $uriQuery['tlsCAFile'] = $MONGO_TLS_CA_FILE;
    $uriQuery['tlsAllowInvalidHostnames'] = 'true';
}

$uri = $baseUri . '/?' . http_build_query($uriQuery, '', '&', PHP_QUERY_RFC1738);

$conn_error = null;
$write_error = null;
$manager = null;
$users = [];
$created = $_GET['created'] ?? '';
$cluster = ['ok' => false, 'primary' => '-', 'setName' => $REPLICA_SET, 'hosts' => []];

function h($s) {
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
}

function login_sig($username, $secret) {
    return hash_hmac('sha256', $username, $secret);
}

$login_error = null;
$logged_user = $_COOKIE[$LOGIN_COOKIE] ?? '';
$logged_sig = $_COOKIE[$LOGIN_COOKIE_SIG] ?? '';
$is_logged_in = $logged_user !== '' && hash_equals(login_sig($logged_user, $LOGIN_SECRET), $logged_sig);

if (isset($_GET['logout'])) {
    setcookie($LOGIN_COOKIE, '', time() - 3600, '/');
    setcookie($LOGIN_COOKIE_SIG, '', time() - 3600, '/');
    header('Location: ' . strtok($_SERVER['REQUEST_URI'], '?'));
    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'login') {
    $candidate_user = trim($_POST['login_user'] ?? '');
    $candidate_pass = $_POST['login_pass'] ?? '';
    $login_ok = $LOGIN_ENFORCED
        ? ($candidate_user === $LOGIN_USER && $candidate_pass === $LOGIN_PASS)
        : ($candidate_user !== '');

    if ($login_ok) {
        setcookie($LOGIN_COOKIE, $candidate_user, 0, '/');
        setcookie($LOGIN_COOKIE_SIG, login_sig($candidate_user, $LOGIN_SECRET), 0, '/');
        header('Location: ' . strtok($_SERVER['REQUEST_URI'], '?'));
        exit;
    }

    $login_error = $LOGIN_ENFORCED
        ? 'Sai tài khoản hoặc mật khẩu.'
        : 'Nhập một username bất kỳ để đăng nhập.';
}

if (!extension_loaded('mongodb')) {
    $conn_error = "PHP MongoDB extension is not loaded.";
} else {
    try {
        $manager = new MongoDB\Driver\Manager($uri);
    } catch (Throwable $e) {
        $conn_error = $e->getMessage();
    }
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'create_user' && $manager) {
    try {
        if (!$is_logged_in) {
            throw new RuntimeException('Bạn cần đăng nhập trước khi tạo user.');
        }

        $username = trim($_POST['username'] ?? '');
        $email = trim($_POST['email'] ?? '');
        $role = $_POST['role'] ?? 'app_reader';
        $password = $_POST['password'] ?? '';

        if ($username === '') {
            throw new RuntimeException('Username is required.');
        }

        $bulk = new MongoDB\Driver\BulkWrite;
        $bulk->insert([
            'username' => $username,
            'email' => $email,
            'role' => in_array($role, ['app_reader', 'app_writer', 'app_admin'], true) ? $role : 'app_reader',
            'password_hash' => $password !== '' ? password_hash($password, PASSWORD_BCRYPT) : 'unset',
            'created_by_web' => true,
            'created_at' => new MongoDB\BSON\UTCDateTime(),
        ]);
        $manager->executeBulkWrite("$DB_NAME.users", $bulk);

        $audit = new MongoDB\Driver\BulkWrite;
        $audit->insert([
            'user' => $logged_user,
            'action' => 'WEB_USER_CREATE',
            'target' => "users/$username",
            'ip' => $_SERVER['REMOTE_ADDR'] ?? 'unknown',
            'ts' => new MongoDB\BSON\UTCDateTime(),
        ]);
        $manager->executeBulkWrite("$DB_NAME.audit_log", $audit);

        header('Location: ' . strtok($_SERVER['REQUEST_URI'], '?') . '?created=1');
        exit;
    } catch (Throwable $e) {
        $write_error = $e->getMessage();
    }
}

if ($manager) {
    try {
        $hello = new MongoDB\Driver\Command(['hello' => 1]);
        $res = $manager->executeCommand('admin', $hello)->toArray()[0];
        $cluster = [
            'ok' => true,
            'primary' => $res->primary ?? '-',
            'setName' => $res->setName ?? 'rs0',
            'hosts' => $res->hosts ?? [],
        ];

        $query = new MongoDB\Driver\Query([], ['sort' => ['created_at' => -1], 'limit' => 30]);
        $users = iterator_to_array($manager->executeQuery("$DB_NAME.users", $query), false);
    } catch (Throwable $e) {
        $conn_error = $e->getMessage();
    }
}

function fmt_date($value) {
    if ($value instanceof MongoDB\BSON\UTCDateTime) {
        return $value->toDateTime()->format('Y-m-d H:i');
    }
    return '-';
}
?><!DOCTYPE html>
