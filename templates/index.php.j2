<?php
// =========================================================================
//  CIS-Benchmark MongoDB Demo App
//  - Web client kết nối Replica Set, hiển thị dữ liệu mẫu của workload thật
//  - Có 4 tab: Users / Messages / Orders / Audit Log (khớp seed_data.yaml)
//  - Cố ý connect "đơn giản" để CIS audit có thể phát hiện vấn đề hạ tầng
// =========================================================================

$DB_IPS = "{% for host in groups['database_nodes'] %}{{ hostvars[host].ansible_host }}:{{ mongodb_port }}{% if not loop.last %},{% endif %}{% endfor %}";
$DB_NAME = "{{ mongodb_db }}";
$MONGO_USER = "{{ mongodb_app_user | default('') }}";
$MONGO_PASS = "{{ mongodb_app_pass | default('') }}";
$MONGO_TLS = {% if mongodb_app_tls | default(false) | bool %}true{% else %}false{% endif %};
$MONGO_TLS_CA_FILE = "{{ mongodb_tls_ca_file | default('/etc/ssl/mongodb/mongoCA.crt') }}";
$MONGO_TLS_CLIENT_PEM = "{{ mongodb_tls_client_pem | default('') }}";
$REPLICA_SET = "{{ replica_set_name | default('rs0') }}";

$baseUri = $MONGO_USER !== ''
    ? sprintf("mongodb://%s:%s@%s", rawurlencode($MONGO_USER), rawurlencode($MONGO_PASS), $DB_IPS)
    : "mongodb://$DB_IPS";

$uriQuery = [
    'replicaSet' => $REPLICA_SET,
    'serverSelectionTimeoutMS' => 5000,
    'connectTimeoutMS' => 5000,
    'socketTimeoutMS' => 5000,
];

if ($MONGO_USER !== '') {
    $uriQuery['authSource'] = 'admin';
}

if ($MONGO_TLS) {
    $uriQuery['tls'] = 'true';
    $uriQuery['tlsCAFile'] = $MONGO_TLS_CA_FILE;
    if ($MONGO_TLS_CLIENT_PEM !== '') {
        $uriQuery['tlsCertificateKeyFile'] = $MONGO_TLS_CLIENT_PEM;
    }
    $uriQuery['tlsAllowInvalidHostnames'] = 'true';
}

$uri = $baseUri . '/?' . http_build_query($uriQuery, '', '&', PHP_QUERY_RFC1738);

$conn_error = null;
$write_error = null;
$manager = null;
$users = [];
$created = $_GET['created'] ?? '';

function h($s) {
    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
}

if (!extension_loaded('mongodb')) {
    $conn_error = "PHP MongoDB extension is not loaded.";
} else {
    try {
        $manager = new MongoDB\Driver\Manager($uri);
    } catch (Throwable $e) {
        $conn_error = $e->getMessage();
    }
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'create_user' && $manager) {
    try {
        $username = trim($_POST['username'] ?? '');
        $email = trim($_POST['email'] ?? '');

        if ($username === '') {
            throw new RuntimeException('Username is required.');
        }

        $bulk = new MongoDB\Driver\BulkWrite;
        $bulk->insert([
            'username' => $username,
            'email' => $email,
            'created_at' => new MongoDB\BSON\UTCDateTime(),
        ]);
        $manager->executeBulkWrite("$DB_NAME.users", $bulk);

        header('Location: ' . strtok($_SERVER['REQUEST_URI'], '?') . '?created=1');
        exit;
    } catch (Throwable $e) {
        $write_error = $e->getMessage();
    }
}

if ($manager) {
    try {
        $query = new MongoDB\Driver\Query([], ['sort' => ['created_at' => -1], 'limit' => 20]);
        $users = iterator_to_array($manager->executeQuery("$DB_NAME.users", $query), false);
    } catch (Throwable $e) {
        $conn_error = $e->getMessage();
    }
}

function fmt_date($value) {
    if ($value instanceof MongoDB\BSON\UTCDateTime) {
        return $value->toDateTime()->format('Y-m-d H:i');
    }
    return '-';
}
?><!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MongoDB Demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f5f7fb; }
        .page { max-width: 800px; }
    </style>
</head>
<body>
<nav class="navbar navbar-dark bg-dark">
    <div class="container page">
        <span class="navbar-brand">MongoDB Demo</span>
    </div>
</nav>

<main class="container page my-4">
    <?php if ($conn_error): ?>
        <div class="alert alert-danger">
            <strong>Không kết nối được MongoDB:</strong> <?= h($conn_error) ?>
        </div>
    <?php endif; ?>

    <?php if ($write_error): ?>
        <div class="alert alert-danger">
            <strong>Không ghi được dữ liệu:</strong> <?= h($write_error) ?>
        </div>
    <?php elseif ($created): ?>
        <div class="alert alert-success">Đã ghi dữ liệu thành công.</div>
    <?php endif; ?>

    <section class="card mb-4">
        <div class="card-header bg-white">
            <strong>Ghi dữ liệu vào MongoDB</strong>
        </div>
        <div class="card-body">
            <form method="POST" class="row g-2">
                <input type="hidden" name="action" value="create_user">
                <div class="col-md-5">
                    <input class="form-control" name="username" placeholder="username" required>
                </div>
                <div class="col-md-5">
                    <input class="form-control" type="email" name="email" placeholder="email">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">Ghi</button>
                </div>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="card-header bg-white">
            <strong>Dữ liệu trong collection <?= h($DB_NAME) ?>.users</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($users as $user): ?>
                    <tr>
                        <td><strong><?= h($user->username ?? '') ?></strong></td>
                        <td><?= h($user->email ?? '') ?></td>
                        <td><?= fmt_date($user->created_at ?? null) ?></td>
                    </tr>
                <?php endforeach; ?>
                <?php if (!$users): ?>
                    <tr><td colspan="3" class="text-muted text-center py-4">Chưa có dữ liệu.</td></tr>
                <?php endif; ?>
                </tbody>
            </table>
        </div>
    </section>
</main>
</body>
</html>
