<?php
// =========================================================================
//  CIS-Benchmark MongoDB Demo App
//  - Web client kết nối Replica Set, hiển thị dữ liệu mẫu của workload thật
//  - Có 4 tab: Users / Messages / Orders / Audit Log (khớp seed_data.yaml)
//  - Cố ý connect "đơn giản" để CIS audit có thể phát hiện vấn đề hạ tầng
// =========================================================================

$DB_IPS = "{% for host in groups['database_nodes'] %}{{ hostvars[host].ansible_host }}:27017{% if not loop.last %},{% endif %}{% endfor %}";
$DB_NAME = "{{ mongodb_db }}";
$MONGO_USER = "{{ mongodb_app_user | default('') }}";
$MONGO_PASS = "{{ mongodb_app_pass | default('') }}";

// Build URI: nếu auth chưa bật thì connect anonymous, nếu đã bật thì dùng credential
if ($MONGO_USER !== '') {
    $uri = sprintf(
        "mongodb://%s:%s@%s/?replicaSet=rs0&authSource=admin",
        rawurlencode($MONGO_USER), rawurlencode($MONGO_PASS), $DB_IPS
    );
} else {
    $uri = "mongodb://$DB_IPS/?replicaSet=rs0";
}

$conn_error = null;
$manager = null;
try {
    $manager = new MongoDB\Driver\Manager($uri);
} catch (Exception $e) {
    $conn_error = $e->getMessage();
}

// -------------------- Helpers --------------------
function h($s) { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); }

function fetch_all($manager, $db, $coll, $sort = null, $limit = 100) {
    $opts = ['limit' => $limit];
    if ($sort) $opts['sort'] = $sort;
    $q = new MongoDB\Driver\Query([], $opts);
    $cursor = $manager->executeQuery("$db.$coll", $q);
    return iterator_to_array($cursor, false);
}

function fmt_date($v) {
    if ($v instanceof MongoDB\BSON\UTCDateTime) {
        return $v->toDateTime()->format('Y-m-d H:i');
    }
    return h((string)$v);
}

function replica_status($manager) {
    try {
        $cmd = new MongoDB\Driver\Command(['hello' => 1]);
        $res = $manager->executeCommand('admin', $cmd)->toArray()[0];
        return [
            'primary'   => $res->primary   ?? 'unknown',
            'me'        => $res->me        ?? 'unknown',
            'setName'   => $res->setName   ?? 'unknown',
            'hosts'     => $res->hosts     ?? [],
            'ok'        => true,
        ];
    } catch (Exception $e) {
        return ['ok' => false, 'err' => $e->getMessage()];
    }
}

// -------------------- Helper: ghi audit_log --------------------
function audit_write($manager, $db, $user, $action, $target, $extra = []) {
    try {
        $bulk = new MongoDB\Driver\BulkWrite;
        $doc = array_merge([
            'user'   => $user,
            'action' => $action,
            'target' => $target,
            'ip'     => $_SERVER['REMOTE_ADDR'] ?? 'unknown',
            'ts'     => new MongoDB\BSON\UTCDateTime(),
        ], $extra);
        $bulk->insert($doc);
        $manager->executeBulkWrite("$db.audit_log", $bulk);
    } catch (Exception $e) { /* audit không được làm vỡ flow chính */ }
}

// -------------------- Xử lý POST --------------------
$flash = null;
if ($_SERVER['REQUEST_METHOD'] === 'POST' && $manager) {
    $tab_redirect = $_POST['tab'] ?? 'messages';
    $flash_code = 'ok';
    try {
        $action = $_POST['action'] ?? '';
        $bulk = new MongoDB\Driver\BulkWrite;

        if ($action === 'add_message' && !empty($_POST['content'])) {
            $author = $_POST['author'] ?? 'guest';
            $bulk->insert([
                'author'     => $author,
                'content'    => $_POST['content'],
                'visibility' => $_POST['visibility'] ?? 'public',
                'created_at' => new MongoDB\BSON\UTCDateTime(),
            ]);
            $manager->executeBulkWrite("$DB_NAME.messages", $bulk);
            audit_write($manager, $DB_NAME, $author, 'MESSAGE_CREATE', 'messages');

        } elseif ($action === 'add_order' && !empty($_POST['user']) && !empty($_POST['sku'])) {
            $u = $_POST['user'];
            $qty = max(1, (int)($_POST['qty'] ?? 1));
            $price = max(0, (int)($_POST['price'] ?? 0));
            $bulk->insert([
                'user'       => $u,
                'items'      => [['sku' => $_POST['sku'], 'qty' => $qty, 'price' => $price]],
                'total'      => $qty * $price,
                'status'     => 'pending',
                'created_at' => new MongoDB\BSON\UTCDateTime(),
            ]);
            $manager->executeBulkWrite("$DB_NAME.orders", $bulk);
            audit_write($manager, $DB_NAME, $u, 'ORDER_CREATE', 'orders',
                ['amount' => $qty * $price]);

        } elseif ($action === 'add_user' && !empty($_POST['username'])) {
            $uname = trim($_POST['username']);
            $email = trim($_POST['email'] ?? '');
            $role  = $_POST['role'] ?? 'app_reader';
            $pwd   = $_POST['password'] ?? '';
            $bulk->insert([
                'username'      => $uname,
                'email'         => $email,
                'role'          => in_array($role, ['app_reader','app_writer','app_admin']) ? $role : 'app_reader',
                'password_hash' => $pwd !== '' ? password_hash($pwd, PASSWORD_BCRYPT) : 'unset',
                'created_at'    => new MongoDB\BSON\UTCDateTime(),
            ]);
            $manager->executeBulkWrite("$DB_NAME.users", $bulk);
            audit_write($manager, $DB_NAME, 'admin', 'USER_CREATE', "users/$uname");
            $tab_redirect = 'users';

        } elseif ($action === 'delete_message' && !empty($_POST['id'])) {
            $bulk->delete(['_id' => new MongoDB\BSON\ObjectId($_POST['id'])], ['limit' => 1]);
            $manager->executeBulkWrite("$DB_NAME.messages", $bulk);
            audit_write($manager, $DB_NAME, 'admin', 'MESSAGE_DELETE', 'messages/' . $_POST['id']);
        }
    } catch (Exception $e) {
        $flash_code = 'err';
        error_log('[demo-app] write error: ' . $e->getMessage());
    }
    // PRG: tránh resubmit khi reload
    header('Location: ' . strtok($_SERVER['REQUEST_URI'], '?')
        . '?tab=' . urlencode($tab_redirect)
        . '&flash=' . $flash_code);
    exit;
}

// -------------------- Đọc dữ liệu --------------------
$tab = $_GET['tab'] ?? 'users';
$flash_get = $_GET['flash'] ?? null;

$data = ['users' => [], 'messages' => [], 'orders' => [], 'audit' => []];
$repl = ['ok' => false];
if ($manager) {
    $repl = replica_status($manager);
    try {
        $data['users']    = fetch_all($manager, $DB_NAME, 'users',     ['created_at' => -1], 50);
        $data['messages'] = fetch_all($manager, $DB_NAME, 'messages',  ['created_at' => -1], 50);
        $data['orders']   = fetch_all($manager, $DB_NAME, 'orders',    ['created_at' => -1], 50);
        $data['audit']    = fetch_all($manager, $DB_NAME, 'audit_log', ['ts' => -1], 50);
    } catch (Exception $e) {
        $conn_error = $e->getMessage();
    }
}
