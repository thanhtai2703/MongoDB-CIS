    <section class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card metric h-100">
                <div class="card-body">
                    <div class="text-muted small">MongoDB</div>
                    <div class="h5 mb-0">
                        <span class="status-dot <?= $cluster['ok'] ? 'status-ok' : 'status-bad' ?>"></span>
                        <?= $cluster['ok'] ? 'Connected' : 'Disconnected' ?>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric h-100">
                <div class="card-body">
