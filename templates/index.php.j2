                    <div class="h5 mb-0"><?= $MONGO_USER ? 'auth: ' . h($MONGO_USER) : 'no auth' ?></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric h-100">
                <div class="card-body">
                    <div class="text-muted small">Transport</div>
                    <div class="h5 mb-0"><?= $MONGO_TLS ? 'TLS enabled' : 'plain TCP' ?></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card metric h-100">
                <div class="card-body">
                    <div class="text-muted small">Users loaded</div>
                    <div class="h5 mb-0"><?= count($users) ?></div>
                </div>
            </div>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>Application login</strong>
            <span class="badge <?= $LOGIN_ENFORCED ? 'text-bg-success' : 'text-bg-warning' ?>">
                <?= $LOGIN_ENFORCED ? 'RBAC enforced' : 'Before remediation: any login accepted' ?>
            </span>
        </div>
        <div class="card-body">
            <?php if ($login_error): ?>
                <div class="alert alert-danger"><?= h($login_error) ?></div>
            <?php endif; ?>

            <?php if ($is_logged_in): ?>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        Signed in as <strong><?= h($logged_user) ?></strong>.
                        <?php if ($LOGIN_ENFORCED): ?>
                            <span class="text-muted">Only the configured application account can modify data.</span>
                        <?php else: ?>
                            <span class="text-muted">Before remediation mode accepts any username.</span>
                        <?php endif; ?>
                    </div>
                    <a class="btn btn-outline-secondary btn-sm" href="?logout=1">Logout</a>
                </div>
            <?php else: ?>
                <form method="POST" class="row g-2">
                    <input type="hidden" name="action" value="login">
                    <div class="col-md-4">
                        <input class="form-control" name="login_user" placeholder="<?= $LOGIN_ENFORCED ? 'app_writer' : 'any username' ?>" required>
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" type="password" name="login_pass" placeholder="<?= $LOGIN_ENFORCED ? 'WriterPass123!' : 'any password' ?>">
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-dark w-100">Login</button>
                    </div>
                </form>
            <?php endif; ?>
