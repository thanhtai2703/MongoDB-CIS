    <?php if ($write_error): ?>
        <div class="alert alert-danger">
            <strong>Không tạo được user:</strong> <?= h($write_error) ?>
        </div>
    <?php elseif ($created): ?>
        <div class="alert alert-success">Tạo user thành công. Workload vẫn ghi được dữ liệu.</div>
