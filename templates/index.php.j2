                <input type="hidden" name="action" value="create_user">
                <div class="col-md-2">
                    <input class="form-control" name="username" placeholder="username" required <?= $is_logged_in ? '' : 'disabled' ?>>
                </div>
                <div class="col-md-3">
                    <input class="form-control" type="email" name="email" placeholder="email" <?= $is_logged_in ? '' : 'disabled' ?>>
                </div>
                <div class="col-md-3">
                    <input class="form-control" type="password" name="password" placeholder="password" <?= $is_logged_in ? '' : 'disabled' ?>>
                </div>
                <div class="col-md-2">
                    <select class="form-select" name="role" <?= $is_logged_in ? '' : 'disabled' ?>>
                        <option value="app_reader">app_reader</option>
                        <option value="app_writer">app_writer</option>
                        <option value="app_admin">app_admin</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" <?= $is_logged_in ? '' : 'disabled' ?>>Create</button>
